rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() { return request.auth != null; }
    function salaActual(c) { return get(/databases/$(database)/documents/salas/$(c)).data; }
    function esLM(c) { return logueado() && salaActual(c).loremasterId == request.auth.uid; }
    function miFicha(c) { return get(/databases/$(database)/documents/salas/$(c)/jugadores/$(request.auth.uid)); }
    function esMiembro(c) {
      return logueado()
        && exists(/databases/$(database)/documents/salas/$(c)/jugadores/$(request.auth.uid))
        && miFicha(c).data.estado in ['activo', 'pausa'];
    }

    function statValida(v) { return v is number && v >= 0 && v <= 15; }

    function personajeValido(d) {
      return d.nombre is string
        && d.nombre.size() >= 1 && d.nombre.size() <= 30
        && d.estado in ['vivo', 'muerto']
        && d.stats.vida is number && statValida(d.stats.vida)
        && statValida(d.stats.fuerza)
        && statValida(d.stats.magia)
        && statValida(d.stats.encanto)
        && d.vidaActual is number && statValida(d.vidaActual)
        && d.magiaActual is number && statValida(d.magiaActual)
        && d.habilidadesMax is number && d.habilidadesMax >= 1 && d.habilidadesMax <= 3
        && d.habilidadesExtra is number && d.habilidadesExtra >= 0 && d.habilidadesExtra <= 2
        && d.habilidades is list
        && d.habilidades.size() <= d.habilidadesMax + d.habilidadesExtra
        && d.inventario is list && d.inventario.size() <= 10;
    }

    function tiradaBasica(d) {
      return d.keys().hasOnly(['uid', 'nombre', 'resultado', 'creadoEn'])
        && d.uid == request.auth.uid
        && d.nombre is string && d.nombre.size() >= 1 && d.nombre.size() <= 30
        && d.resultado is int
        && d.resultado >= 1 && d.resultado <= 20
        && d.creadoEn == request.time;
    }

    function hayTurnos(c) {
      return exists(/databases/$(database)/documents/salas/$(c)/turnos/estado);
    }
    function turnoAntes(c) {
      return get(/databases/$(database)/documents/salas/$(c)/turnos/estado).data;
    }
    function turnoDespues(c) {
      return getAfter(/databases/$(database)/documents/salas/$(c)/turnos/estado).data;
    }
    function duenoDe(c, personajeId) {
      return get(/databases/$(database)/documents/salas/$(c)/personajes/$(personajeId)).data.meta.duenoUid;
    }

    function turnosValidos(d) {
      return d.keys().hasOnly(['orden', 'actual', 'ronda', 'pendientes', 'tiradasRestantes', 'infinitas', 'diaRondas', 'nocheRondas'])
        && d.orden is list && d.orden.size() >= 1 && d.orden.size() <= 30
        && d.actual in d.orden
        && d.ronda is int && d.ronda >= 1 && d.ronda <= 9999
        && d.pendientes is map
        && d.tiradasRestantes is int && d.tiradasRestantes >= 0 && d.tiradasRestantes <= 9
        && d.infinitas is bool
        && d.diaRondas is int && d.diaRondas >= 1 && d.diaRondas <= 20
        && d.nocheRondas is int && d.nocheRondas >= 1 && d.nocheRondas <= 20;
    }

    match /salas/{codigo} {
      allow get: if logueado();
      allow list: if false;

      allow create: if logueado()
        && codigo.matches('^[A-Z0-9]{4}$')
        && request.resource.data.keys().hasOnly(['loremasterId', 'creadaEn', 'version', 'config'])
        && request.resource.data.loremasterId == request.auth.uid;

      allow update: if esLM(codigo);
      allow delete: if false;

      match /jugadores/{uid} {
        allow read: if logueado() && (uid == request.auth.uid || esLM(codigo) || esMiembro(codigo));

        allow create: if logueado()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'nombre', 'esLoremaster', 'estado', 'creadoEn'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() >= 1
          && request.resource.data.nombre.size() <= 20
          && (
            (exists(/databases/$(database)/documents/salas/$(codigo))
              && request.resource.data.esLoremaster == false
              && request.resource.data.estado == 'esperando')
            ||
            (getAfter(/databases/$(database)/documents/salas/$(codigo)).data.loremasterId == request.auth.uid
              && request.resource.data.esLoremaster == true
              && request.resource.data.estado == 'activo')
          );

        allow update: if esLM(codigo)
          || (uid == request.auth.uid
              && resource.data.estado in ['activo', 'pausa']
              && request.resource.data.estado in ['activo', 'pausa']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']));

        allow delete: if esLM(codigo) || uid == request.auth.uid;
      }

      match /personajes/{personajeId} {
        allow read: if esLM(codigo) || esMiembro(codigo);
        allow create: if esLM(codigo) && personajeValido(request.resource.data);
        allow update: if esLM(codigo) && personajeValido(request.resource.data);
        allow delete: if esLM(codigo);
      }

      match /tiradas/{tiradaId} {
        allow read: if esLM(codigo) || esMiembro(codigo);
        allow create: if tiradaBasica(request.resource.data) && (
          esLM(codigo)
          || (esMiembro(codigo) && !hayTurnos(codigo))
          || (esMiembro(codigo) && hayTurnos(codigo)
              && duenoDe(codigo, turnoAntes(codigo).actual) == request.auth.uid
              && turnoAntes(codigo).tiradasRestantes >= 1
              && turnoDespues(codigo).tiradasRestantes == turnoAntes(codigo).tiradasRestantes - 1)
        );
        allow update, delete: if false;
      }

      match /turnos/{docId} {
        allow read: if esLM(codigo) || esMiembro(codigo);
        allow create: if esLM(codigo) && turnosValidos(request.resource.data);
        allow update: if (esLM(codigo) && turnosValidos(request.resource.data))
          || (esMiembro(codigo)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tiradasRestantes'])
              && resource.data.tiradasRestantes >= 1
              && request.resource.data.tiradasRestantes == resource.data.tiradasRestantes - 1
              && duenoDe(codigo, resource.data.actual) == request.auth.uid);
        allow delete: if esLM(codigo);
      }
    }
  }
}
